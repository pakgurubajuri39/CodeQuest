rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidStudent(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.username is string && data.username.size() <= 64 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['student', 'admin'] &&
             data.status in ['trial', 'pending', 'approved', 'rejected'] &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('xp' in data) || (data.xp is number && data.xp >= 0)) &&
             (!('gems' in data) || (data.gems is number && data.gems >= 0)) &&
             (!('heroLevel' in data) || (data.heroLevel is number && data.heroLevel >= 1));
    }

    // Students collection: Public read for learning roster, verified writes
    match /students/{studentId} {
      allow get, list: if isValidId(studentId);
      allow create: if isValidId(studentId) && isValidStudent(incoming());
      allow update: if isValidId(studentId) && isValidStudent(incoming());
      allow delete: if isValidId(studentId);
    }
  }
}
